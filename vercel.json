{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "data/**,templates/**,static/**,backend/**,services/**"
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "data/**",
          "templates/**",
          "static/**",
          "backend/**",
          "services/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}

